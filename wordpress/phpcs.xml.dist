<?xml version="1.0"?>
<ruleset name="salon-demos WordPress">
	<description>WordPress Coding Standards for the salon-demos themes and the salon-booking-enquiry plugin.</description>

	<file>themes/sable-hello-child</file>
	<file>themes/dewlab-block</file>
	<file>plugins/salon-booking-enquiry</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/assets/build/*</exclude-pattern>
	<exclude-pattern>*.js</exclude-pattern>
	<exclude-pattern>*.css</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="parallel" value="8"/>

	<config name="minimum_wp_version" value="6.5"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress">
		<!-- PHPStan generics/array shapes in @param (list<string>, Clean, ...) are intentional. -->
		<exclude name="Squiz.Commenting.FunctionComment.IncorrectTypeHint"/>
	</rule>
	<rule ref="PHPCompatibilityWP"/>

	<!-- Plugin classes follow PSR-4 file naming (src/Rest/EnquiryController.php), not class-*.php. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>plugins/salon-booking-enquiry/src/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="sable"/>
				<element value="dewlab"/>
				<element value="salon_booking_enquiry"/>
				<element value="SalonBookingEnquiry"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="sable-hello-child"/>
				<element value="dewlab-block"/>
				<element value="salon-booking-enquiry"/>
			</property>
		</properties>
	</rule>
</ruleset>
