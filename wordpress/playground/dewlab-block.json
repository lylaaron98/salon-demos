{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "Dewlab Skin Studio: block theme demo",
    "description": "Fictional skin studio on a token-driven block theme (theme.json v3, self-hosted fonts, no jQuery) with the salon-booking-enquiry plugin. Portfolio demo; all brands and data are fictional.",
    "author": "lylaaron98",
    "categories": ["Themes", "Demo"]
  },
  "landingPage": "/",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "login": true,
  "steps": [
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "url",
        "url": "https://github.com/lylaaron98/salon-demos/releases/download/wp-latest/salon-booking-enquiry.zip",
        "caption": "Installing salon-booking-enquiry"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "url",
        "url": "https://github.com/lylaaron98/salon-demos/releases/download/wp-latest/dewlab-block.zip",
        "caption": "Installing the Dewlab block theme"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "writeFile",
      "path": "/tmp/dewlab-block-setup.php",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/lylaaron98/salon-demos/main/wordpress/playground/setup/dewlab-block.php",
        "caption": "Downloading demo content"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require_once '/wordpress/wp-load.php'; wp_set_current_user( 1 ); require '/tmp/dewlab-block-setup.php';",
      "progress": {
        "caption": "Creating demo pages"
      }
    }
  ]
}
