{
  "name": "salon-demos/wordpress",
  "description": "Dev tools only (PHPCS + WordPress Coding Standards, PHPStan + WordPress stubs) for the salon-demos WordPress theme and plugin. Nothing here is needed at runtime.",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "php-stubs/wordpress-stubs": "^6.8",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/phpstan": "^2.1",
    "squizlabs/php_codesniffer": "^3.13",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "8.1.99"
    },
    "sort-packages": true
  },
  "scripts": {
    "lint:php": "find themes plugins -name '*.php' -not -path '*/vendor/*' -print0 | xargs -0 -n1 php -l",
    "phpcs": "phpcs",
    "phpcbf": "phpcbf",
    "phpstan": "phpstan analyse --memory-limit=1G",
    "check": [
      "@lint:php",
      "@phpcs",
      "@phpstan"
    ]
  }
}
