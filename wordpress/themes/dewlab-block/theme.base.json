{
  "$schema": "https://schemas.wp.org/wp/6.8/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "shadow": {
      "defaultPresets": false,
      "presets": [
        { "slug": "sm", "name": "Small", "shadow": "var(--shadow-sm)" },
        { "slug": "md", "name": "Medium", "shadow": "var(--shadow-md)" },
        { "slug": "lg", "name": "Large", "shadow": "var(--shadow-lg)" }
      ]
    },
    "typography": {
      "writingMode": false,
      "dropCap": false
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--bg-page)",
      "text": "var(--wp--preset--color--text-primary)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--md)",
      "lineHeight": "var(--line-height-md)"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--6)",
      "padding": {
        "left": "var(--wp--preset--spacing--4)",
        "right": "var(--wp--preset--spacing--4)"
      }
    },
    "elements": {
      "link": {
        "color": { "text": "var(--wp--preset--color--action-primary)" },
        "typography": { "textDecoration": "underline" },
        ":hover": {
          "color": { "text": "var(--wp--preset--color--action-hover)" }
        }
      },
      "heading": {
        "color": { "text": "var(--wp--preset--color--text-primary)" },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "var(--display-weight)",
          "letterSpacing": "var(--display-letter-spacing)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--5-xl)",
          "lineHeight": "var(--line-height-5xl)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--4-xl)",
          "lineHeight": "var(--line-height-4xl)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--2-xl)",
          "lineHeight": "var(--line-height-2xl)"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xl)",
          "lineHeight": "var(--line-height-xl)"
        }
      },
      "h5": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)",
          "fontSize": "var(--wp--preset--font-size--lg)",
          "fontWeight": "var(--font-weight-bold)",
          "letterSpacing": "0"
        }
      },
      "h6": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)",
          "fontSize": "var(--wp--preset--font-size--sm)",
          "fontWeight": "var(--font-weight-bold)",
          "letterSpacing": "0"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--action-primary)",
          "text": "var(--color-action-text)"
        },
        "border": { "radius": "var(--radius-button)", "width": "0" },
        "spacing": {
          "padding": {
            "top": "var(--wp--preset--spacing--3)",
            "bottom": "var(--wp--preset--spacing--3)",
            "left": "var(--wp--preset--spacing--6)",
            "right": "var(--wp--preset--spacing--6)"
          }
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)",
          "fontSize": "var(--button-font-size)",
          "fontWeight": "var(--button-font-weight)",
          "letterSpacing": "var(--button-letter-spacing)",
          "lineHeight": "1.5",
          "textDecoration": "none"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--action-hover)",
            "text": "var(--color-action-text)"
          }
        },
        ":focus": {
          "color": {
            "background": "var(--wp--preset--color--action-hover)",
            "text": "var(--color-action-text)"
          }
        }
      },
      "caption": {
        "color": { "text": "var(--wp--preset--color--text-muted)" },
        "typography": { "fontSize": "var(--wp--preset--font-size--sm)" }
      }
    },
    "blocks": {
      "core/button": {
        "variations": {
          "outline": {
            "border": {
              "color": "var(--color-action-secondary-border)",
              "width": "1.5px",
              "style": "solid"
            },
            "color": {
              "background": "transparent",
              "text": "var(--color-action-secondary-text)"
            },
            "spacing": {
              "padding": {
                "top": "calc(var(--wp--preset--spacing--3) - 1.5px)",
                "bottom": "calc(var(--wp--preset--spacing--3) - 1.5px)",
                "left": "calc(var(--wp--preset--spacing--6) - 1.5px)",
                "right": "calc(var(--wp--preset--spacing--6) - 1.5px)"
              }
            }
          }
        }
      },
      "core/navigation": {
        "typography": { "fontSize": "var(--wp--preset--font-size--md)", "fontWeight": "500" },
        "elements": {
          "link": {
            "color": { "text": "var(--wp--preset--color--text-primary)" },
            "typography": { "textDecoration": "none" },
            ":hover": { "typography": { "textDecoration": "underline" } }
          }
        }
      },
      "core/site-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontSize": "var(--wp--preset--font-size--2-xl)",
          "lineHeight": "1"
        },
        "elements": {
          "link": {
            "color": { "text": "var(--wp--preset--color--text-primary)" },
            "typography": { "textDecoration": "none" }
          }
        }
      },
      "core/quote": {
        "border": { "width": "0" },
        "spacing": { "padding": { "left": "0" } },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontSize": "var(--wp--preset--font-size--xl)",
          "lineHeight": "var(--line-height-xl)"
        },
        "elements": {
          "cite": {
            "typography": {
              "fontFamily": "var(--wp--preset--font-family--body)",
              "fontSize": "var(--wp--preset--font-size--sm)",
              "fontStyle": "normal"
            },
            "color": { "text": "var(--wp--preset--color--text-muted)" }
          }
        }
      },
      "core/separator": {
        "color": { "text": "var(--color-border-subtle)" }
      },
      "core/post-date": {
        "color": { "text": "var(--wp--preset--color--text-muted)" },
        "typography": { "fontSize": "var(--wp--preset--font-size--sm)" }
      },
      "core/search": {
        "border": { "radius": "var(--radius-input)" }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    {
      "name": "page-landing",
      "title": "Landing page (no title, full width)",
      "postTypes": ["page"]
    }
  ]
}
