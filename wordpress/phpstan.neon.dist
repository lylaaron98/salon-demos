includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	level: 6
	phpVersion: 80100
	paths:
		- themes/sable-hello-child
		- themes/dewlab-block
		- themes/dewlab-divi-child
		- plugins/salon-booking-enquiry
		- playground/setup
	excludePaths:
		analyse:
			- */vendor/*
			- */node_modules/*
	scanFiles:
		- stubs/elementor.php
	bootstrapFiles:
		- stubs/constants.php
	treatPhpDocTypesAsCertain: false
