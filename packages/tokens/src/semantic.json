      },
      "accent": {
        "$value": "{p.ink-900}"
      }
    },
    "text": {
      "primary": {
        "$value": "{p.ink-900}"
      },
      "muted": {
        "$value": "{p.ink-600}"
      },
      "inverse": {
        "$value": "{p.paper-50}"
      },
      "accent": {
        "$value": "{p.ink-900}"
      },
      "on-accent": {
        "$value": "{p.paper-50}"
      }
    },
    "action": {
      "bg": {
        "$value": "{p.ink-900}"
      },
      "bg-hover": {
        "$value": "#3A3633"
      },
      "bg-pressed": {
        "$value": "#3A3633"
      },
      "text": {
        "$value": "{p.neutral-0}"
      },
      "secondary-border": {
        "$value": "{p.ink-900}"
      },
