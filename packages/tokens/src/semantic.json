      },
      "subtle": {
        "$value": "#DDD8D0"
      }
    },
    "focus-ring": {
      "$value": "{p.ink-900}"
    },
    "decor-accent": {
      "$value": "{p.ink-900}"
    },
    "focus-ring-inverse": {
      "$value": "{p.neutral-0}",
      "$description": "Focus ring on dark surfaces (bg-inverse, action-bg)"
    },
    "error": {
      "$value": "{p.red-700}"
    },
    "success": {
      "$value": "{p.green-700}"
    },
