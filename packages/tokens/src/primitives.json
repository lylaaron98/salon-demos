  "font-size": {
    "$type": "dimension",
    "$description": "Major-third type scale, base 16 px, fluid from 390 to 1440 px.",
    "xs": {
      "$value": "clamp(0.75rem, 0.73rem + 0.1vw, 0.8125rem)",
      "$extensions": {
        "com.orrin.px": {
          "mobile": 12,
          "desktop": 13
        }
      }
    },
    "sm": {
      "$value": "clamp(0.875rem, 0.85rem + 0.1vw, 0.9375rem)",
      "$extensions": {
        "com.orrin.px": {
          "mobile": 14,
          "desktop": 15,
          "tablet": 14
        }
      }
    },
    "md": {
      "$value": "clamp(1rem, 0.98rem + 0.1vw, 1.0625rem)",
      "$extensions": {
        "com.orrin.px": {
          "mobile": 16,
          "desktop": 17,
          "tablet": 16
        }
      }
    },
    "lg": {
      "$value": "clamp(1.125rem, 1.08rem + 0.19vw, 1.25rem)",
      "$extensions": {
        "com.orrin.px": {
          "mobile": 18,
          "desktop": 20
        }
      }
    },
    "xl": {
      "$value": "clamp(1.25rem, 1.13rem + 0.48vw, 1.5625rem)",
      "$extensions": {
        "com.orrin.px": {
          "mobile": 20,
          "desktop": 25,
          "tablet": 22
        }
      }
    },
    "2xl": {
      "$value": "clamp(1.5rem, 1.34rem + 0.67vw, 1.9375rem)",
      "$extensions": {
        "com.orrin.px": {
          "mobile": 24,
          "desktop": 31,
          "tablet": 27
        }
      }
    },
    "3xl": {
      "$value": "clamp(1.75rem, 1.49rem + 1.05vw, 2.4375rem)",
      "$extensions": {
        "com.orrin.px": {
          "mobile": 28,
          "desktop": 39,
          "tablet": 33
        }
      }
    },
    "4xl": {
      "$value": "clamp(2.125rem, 1.77rem + 1.43vw, 3.0625rem)",
      "$extensions": {
        "com.orrin.px": {
          "mobile": 34,
          "desktop": 49,
          "tablet": 40
        }
      }
    },
    "5xl": {
      "$value": "clamp(2.5rem, 2.0rem + 2.0vw, 3.8125rem)",
      "$extensions": {
        "com.orrin.px": {
          "mobile": 40,
          "desktop": 61
        }
      }
    }
  },
