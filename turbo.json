{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "SITE_URL",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_GTM_ID",
        "NEXT_PUBLIC_KEYSTATIC_*",
        "KEYSTATIC_*",
        "VERCEL_ENV"
      ]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
